    {
      "name": "Planning field",
      "kind": "input",
      "refersTo": "field",
      "description": "Stable field surfaces inside the visual direction disclosure.",
      "html": "<label class=\"ds-field-label\">Emphasis text · planning note<input class=\"ds-field\" type=\"text\" placeholder=\"Planning note\"></label>",
      "css": ".ds-field-label{font-family:var(--gm-font,-apple-system,BlinkMacSystemFont,\"Helvetica Neue\",sans-serif);font-size:11px;color:var(--t2,#b1b7bf)}.ds-field{font-family:var(--gm-font,-apple-system,BlinkMacSystemFont,\"Helvetica Neue\",sans-serif);display:block;margin-top:6px;font-size:12px;line-height:1.5;background:var(--inbg,#14181d);color:var(--ink,#eceef0);border:1px solid var(--ring,#464e58);border-radius:8px;padding:8px 10px;max-width:100%;min-width:0;caret-color:var(--gm-accent,#e2eaf6)}.ds-field:focus-visible{outline:2px solid var(--gm-accent,#e2eaf6);outline-offset:3px;border-radius:3px;}"
    },
    {
      "name": "Editor navigation",
      "kind": "nav",
      "refersTo": "glass-shell",
      "description": "Glass header with compact current-page pills.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Editor\"><a href=\"#library\">Library</a><a href=\"#board\" aria-current=\"page\">Edit board</a></nav>",
      "css": ".ds-nav{font-family:var(--gm-font,-apple-system,BlinkMacSystemFont,\"Helvetica Neue\",sans-serif);display:inline-flex;padding:4px;gap:4px;border:1px solid var(--gm-glass-edge,rgba(255,255,255,.14));border-radius:999px;background:var(--gm-glass,rgba(39,45,55,.68));backdrop-filter:blur(24px) saturate(1.3);box-shadow:inset 0 1px 0 rgba(255,255,255,.09)}.ds-nav a{padding:7px 16px;border-radius:999px;font-size:12px;color:var(--t2,#b1b7bf);text-decoration:none}.ds-nav a[aria-current]{color:var(--ink,#eceef0);background:#ffffff13;box-shadow:inset 0 1px 0 #ffffff0c}.ds-nav a:focus-visible{outline:2px solid var(--gm-accent,#e2eaf6);outline-offset:3px;border-radius:3px;}@supports not (backdrop-filter:blur(1px)){.ds-nav{background:var(--panel,#1b1e22)}}@media(prefers-reduced-transparency:reduce),(prefers-contrast:more){.ds-nav{background:var(--panel,#1b1e22);backdrop-filter:none;box-shadow:none}}"
    },
    {
      "name": "Source metadata tag",
      "kind": "chip",
      "description": "A quiet text label, not a filled badge.",
      "html": "<span class=\"ds-tag\">Original source</span>",
      "css": ".ds-tag{font-family:var(--gm-font,-apple-system,BlinkMacSystemFont,\"Helvetica Neue\",sans-serif);color:var(--t3,#969fa9);font-size:11px;white-space:nowrap}"
    },
    {
      "name": "Passage container",
      "kind": "card",
      "refersTo": "passages",
      "description": "Matte source-order content with a directly available keep control.",
      "html": "<article class=\"ds-passage\"><span class=\"ds-time\">01&nbsp; 00:00 → 00:08</span><p class=\"ds-copy\">An example passage for reviewing an edit decision.</p><label class=\"ds-keep\"><input type=\"checkbox\" checked>Keep passage</label></article>",
      "css": ".ds-passage{font-family:var(--gm-font,-apple-system,BlinkMacSystemFont,\"Helvetica Neue\",sans-serif);border:1px solid var(--line,#30353c);border-radius:16px;background:var(--panel,#1b1e22);color:var(--ink,#eceef0);padding:16px 20px}.ds-time{font:11px/1.5 var(--mono,\"SFMono-Regular\",Consolas,monospace);color:var(--t3,#969fa9);font-variant-numeric:tabular-nums}.ds-copy{font-size:14px;line-height:1.6;margin:8px 0 12px}.ds-keep{display:flex;align-items:center;gap:6px;min-height:28px;font-size:11px;color:var(--t2,#b1b7bf)}.ds-keep input{width:14px;height:14px;margin:0;accent-color:var(--gm-accent,#e2eaf6)}.ds-keep input:focus-visible{outline:2px solid var(--gm-accent,#e2eaf6);outline-offset:3px;border-radius:3px;}"
    },
    {
      "name": "Source interval",
      "kind": "custom",
      "refersTo": "sequence-segment",
      "description": "Kept, removed, and current real source intervals. Example weights are illustrative.",
      "html": "<div class=\"ds-sequence\"><button class=\"ds-interval ds-current\" aria-label=\"Watch kept source passage 1\" aria-pressed=\"true\" style=\"flex-grow:8\">01</button><button class=\"ds-interval ds-omitted\" aria-label=\"Watch removed source passage 2\" aria-pressed=\"false\" style=\"flex-grow:4\">02</button></div>",
      "css": ".ds-sequence{display:flex;gap:3px;min-height:39px}.ds-interval{flex:1;min-width:28px;overflow:hidden;white-space:nowrap;padding:8px;text-align:left;border:1px solid var(--line,#30353c);border-radius:5px;background:var(--gm-segment,#293543);color:var(--ink,#eceef0);font:11px/1.4 var(--mono,\"SFMono-Regular\",Consolas,monospace);cursor:pointer;transition:background 160ms,border-color 160ms}.ds-interval:hover:not(:disabled){background:var(--soft,#242a31);border-color:var(--t3,#969fa9)}.ds-sequence .ds-interval.ds-omitted{background:var(--bg,#141619);color:var(--t3,#969fa9);border-style:dashed;text-decoration:line-through}.ds-sequence .ds-interval.ds-current{border-color:var(--gm-accent,#e2eaf6)}.ds-interval:focus-visible{outline:2px solid var(--gm-accent,#e2eaf6);outline-offset:3px;border-radius:3px;}.ds-interval:disabled{opacity:.42;cursor:default}@media(prefers-reduced-motion:reduce){.ds-interval{transition-duration:.01ms!important}}"
    }
  ],
  "narrative": {
    "northStar": "The Dark Glass Editing Desk",
    "overview": "Apple-inspired dark Liquid Glass frames the video and its edit decisions. Translucent navigation, restrained graphite working surfaces, and pale blue-white actions give the editor a calm, precise character. The content stays stable beneath the shell: media, transcript passages, planning fields, and status are readable on matte surfaces.\n\nThis is a web interpretation of the owner-selected direction, informed by the Aura references recorded in docs/design/genmedia-editor-direction.md. It is specific to GenMedia Editor; it does not establish a universal GenMedia palette or reproduce Apple’s native material renderer.",
    "keyCharacteristics": [
      "Media and decisions lead the workspace.",
      "Glass is concentrated in navigation and floating controls.",
      "Compact platform typography, rounded controls, and explicit state labels.",
      "Dark appearance by default, with an explicit saved light preference retained."
    ],
    "rules": [
      {
        "name": "The Stable Content Rule",
        "body": "Use glass for the shell and transient controls; keep media, transcript text, planning fields, and status on stable working surfaces.",
        "section": "elevation"
      },
      {
        "name": "The Source Truth Rule",
        "body": "Build the source sequence from real source intervals. Keep removed intervals visible with dashed borders and strike-through; do not replace data with a decorative waveform.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the shared token cascade before adding route-specific styling.",
      "Do preserve the explicit saved light preference and the motion/transparency fallbacks.",
      "Do keep approval and creation of a separate Resolve timeline explicit.",
      "Do retain source media paths, API routes, stored revisions, and existing native timelines across visual changes.",
      "Do keep the review rail scrollable and its Codex control in header layout space.",
      "Do identify synthetic sample footage and distinguish planning notes from rendered output."
    ],
    "donts": [
      "Don’t present this editor palette as a settled brand standard for all GenMedia products.",
      "Don’t put translucent material behind long transcript passages or planning fields.",
      "Don’t imply captions, graphics, generated B-roll, or preview zooms are rendered when they are not.",
      "Don’t rename upstream compatibility identifiers or storage paths to satisfy a visible rebrand.",
      "Don’t infer formal accessibility compliance, creative-quality validation, or measured time savings from screenshots or synthetic samples."
    ]
  }
}
